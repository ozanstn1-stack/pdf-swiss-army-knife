{
  "name": "pdf-swiss-army-knife",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "description": "PDF Swiss Army Knife - local-first desktop PDF toolkit",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test:rust": "cargo test --workspace",
